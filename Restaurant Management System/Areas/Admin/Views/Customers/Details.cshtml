@model RestaurantManagementSystem.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="page-header">
    <div>
        <h1>Customer Details</h1>
        <p>View customer information.</p>
    </div>

    <a asp-action="Index" class="btn btn-light">
        ← Back to Customers
    </a>
</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <div class="d-flex align-items-center mb-4">

            <div class="customer-avatar">
                @Model.FirstName?.Substring(0, 1).ToUpper()
            </div>

            <div class="ms-3">
                <h3 class="mb-1">
                    @Model.FirstName @Model.LastName
                </h3>

                <span class="text-muted">
                    Customer #@Model.CustomerID
                </span>
            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-4">
                <small class="text-muted">First Name</small>
                <div class="fw-semibold">
                    @Model.FirstName
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <small class="text-muted">Last Name</small>
                <div class="fw-semibold">
                    @Model.LastName
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <small class="text-muted">Email</small>
                <div class="fw-semibold">
                    @Model.Email
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <small class="text-muted">Phone</small>
                <div class="fw-semibold">
                    @Model.Phone
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <small class="text-muted">Street</small>
                <div class="fw-semibold">
                    @Model.Street
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <small class="text-muted">City</small>
                <div class="fw-semibold">
                    @Model.City
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <small class="text-muted">Zip Code</small>
                <div class="fw-semibold">
                    @Model.ZipCode
                </div>
            </div>

        </div>

        <hr />

        <div class="d-flex justify-content-end gap-2 mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model.CustomerID"
               class="btn btn-primary">
                Edit Customer
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.CustomerID"
               class="btn btn-outline-danger">
                Delete
            </a>

        </div>

    </div>

</div>