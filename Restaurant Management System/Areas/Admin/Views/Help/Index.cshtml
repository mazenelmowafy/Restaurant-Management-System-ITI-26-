@{
    ViewData["Title"] = "Help Center";
}

<div class="products-page">

    <div class="products-header">

        <div>
            <h1>Help Center</h1>

            <p>
                Find answers and useful information about the admin panel.
            </p>
        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="rounded-3 d-flex align-items-center justify-content-center mb-3"
                         style="width:50px;height:50px;background:#fff1eb;color:#ff6333;">

                        <i class="bi bi-book fs-4"></i>

                    </div>

                    <h5 class="fw-bold">
                        Getting Started
                    </h5>

                    <p class="text-muted">
                        Learn how to manage products, customers and orders.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="rounded-3 d-flex align-items-center justify-content-center mb-3"
                         style="width:50px;height:50px;background:#eef5ff;color:#0d6efd;">

                        <i class="bi bi-question-circle fs-4"></i>

                    </div>

                    <h5 class="fw-bold">
                        Frequently Asked Questions
                    </h5>

                    <p class="text-muted">
                        Find answers to common questions about the system.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="rounded-3 d-flex align-items-center justify-content-center mb-3"
                         style="width:50px;height:50px;background:#edf9f1;color:#198754;">

                        <i class="bi bi-headset fs-4"></i>

                    </div>

                    <h5 class="fw-bold">
                        Support
                    </h5>

                    <p class="text-muted">
                        Need help? Contact the project support team.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Common Questions
            </h5>


            <div class="accordion" id="helpAccordion">

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#questionOne">

                            How do I add a product?

                        </button>

                    </h2>

                    <div id="questionOne"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#helpAccordion">

                        <div class="accordion-body text-muted">

                            Open Products from the sidebar and click
                            <strong>Add Product</strong>.

                        </div>

                    </div>

                </div>


                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#questionTwo">

                            How do I edit a customer?

                        </button>

                    </h2>

                    <div id="questionTwo"
                         class="accordion-collapse collapse"
                         data-bs-parent="#helpAccordion">

                        <div class="accordion-body text-muted">

                            Open Customers, select the customer and click Edit.

                        </div>

                    </div>

                </div>


                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#questionThree">

                            Where can I see order history?

                        </button>

                    </h2>

                    <div id="questionThree"
                         class="accordion-collapse collapse"
                         data-bs-parent="#helpAccordion">

                        <div class="accordion-body text-muted">

                            Open Orders from the Management section.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>