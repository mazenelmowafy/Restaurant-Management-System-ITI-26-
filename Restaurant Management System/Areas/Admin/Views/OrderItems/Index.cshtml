@model IEnumerable<RestaurantManagementSystem.Models.OrderItem>

@{
    ViewData["Title"] = "Order Items";

    var orderItems = Model?.ToList()
        ?? new List<RestaurantManagementSystem.Models.OrderItem>();

    var totalItems = orderItems.Count;

    var totalQuantity = orderItems.Sum(i => i.Quantity);

    var totalValue = orderItems.Sum(i => i.SubTotal);
}


<div class="order-items-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                Order Items
            </h1>

            <p class="text-muted mb-0">
                View all products included in customer orders.
            </p>

        </div>

    </div>


    <!-- ================= STATISTICS ================= -->

    <div class="row g-3 mb-4">

        <!-- Total Order Items -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Order Items
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalItems
                        </h3>

                        <small class="text-muted">
                            Items in orders
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#fff1eb;">

                        <i class="bi bi-list-check fs-4"
                           style="color:#ff6333;">
                        </i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Quantity -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Total Quantity
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalQuantity
                        </h3>

                        <small class="text-muted">
                            Products ordered
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#eef5ff;">

                        <i class="bi bi-box-seam fs-4 text-primary">
                        </i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Value -->

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Total Value
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalValue.ToString("0.00")
                        </h3>

                        <small class="text-muted">
                            Total item value
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#edf9f1;">

                        <i class="bi bi-cash-stack fs-4 text-success">
                        </i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= ORDER ITEMS TABLE ================= -->

    <div class="card border-0 shadow-sm">

        <!-- Header -->

        <div class="card-header bg-white border-0 pt-4 px-4 pb-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        All Order Items
                    </h5>

                    <small class="text-muted">
                        Products purchased by customers
                    </small>

                </div>


                <!-- Search -->

                <div class="orders-search">

                    <i class="bi bi-search orders-search-icon"></i>

                    <input type="text"
                           id="orderItemSearch"
                           class="orders-search-input"
                           placeholder="Search order, product..." />

                    <button type="button"
                            id="clearOrderItemSearch"
                            class="orders-search-clear"
                            aria-label="Clear search">

                        <i class="bi bi-x"></i>

                    </button>

                </div>

            </div>

        </div>


        <!-- Table -->

        <div class="card-body p-0">

            @if (orderItems.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0"
                           id="orderItemsTable">

                        <thead style="background:#f8f9fb;">

                            <tr>

                                <th class="ps-4 py-3">
                                    Order
                                </th>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th class="text-end pe-4">
                                    Subtotal
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in orderItems)
                            {
                                <tr>

                                    <!-- Order -->

                                    <td class="ps-4">

                                        <span class="fw-bold">
                                            #@item.OrderId
                                        </span>

                                    </td>


                                    <!-- Product -->

                                    <td>

                                        @if (item.Product != null)
                                        {
                                            <div class="d-flex align-items-center">

                                                <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                                     style="width:42px;height:42px;background:#fff1eb;color:#ff6333;">

                                                    <i class="bi bi-box-seam"></i>

                                                </div>

                                                <div>

                                                    <div class="fw-semibold">
                                                        @item.Product.Name
                                                    </div>

                                                    <small class="text-muted">
                                                        Product #@item.ProductId
                                                    </small>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Product
                                            </span>
                                        }

                                    </td>


                                    <!-- Unit Price -->

                                    <td>

                                        <span class="fw-semibold">
                                            @item.UnitPrice.ToString("0.00")
                                        </span>

                                    </td>


                                    <!-- Quantity -->

                                    <td>

                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            @item.Quantity
                                        </span>

                                    </td>


                                    <!-- Subtotal -->

                                    <td class="text-end pe-4">

                                        <span class="fw-bold">
                                            @item.SubTotal.ToString("0.00")
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:#f4f5f7;">

                        <i class="bi bi-list-check fs-2 text-muted">
                        </i>

                    </div>

                    <h5 class="fw-bold mb-2">
                        No order items found
                    </h5>

                    <p class="text-muted mb-0">
                        Order items will appear here once customers place orders.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const searchInput =
            document.getElementById("orderItemSearch");

        const clearButton =
            document.getElementById("clearOrderItemSearch");


        if (searchInput) {

            searchInput.addEventListener("input", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    document.querySelectorAll(
                        "#orderItemsTable tbody tr"
                    );


                rows.forEach(function (row) {

                    const rowText =
                        row.innerText.toLowerCase();

                    row.style.display =
                        rowText.includes(searchValue)
                            ? ""
                            : "none";

                });


                if (clearButton) {

                    clearButton.style.display =
                        searchValue.length > 0
                            ? "flex"
                            : "none";

                }

            });

        }


        if (clearButton) {

            clearButton.addEventListener("click", function () {

                searchInput.value = "";

                searchInput.dispatchEvent(
                    new Event("input")
                );

                searchInput.focus();

            });

        }

    </script>

}