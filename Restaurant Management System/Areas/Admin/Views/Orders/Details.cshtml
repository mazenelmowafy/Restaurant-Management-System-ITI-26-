@model RestaurantManagementSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";

    var customerName = Model.Customer != null
        ? $"{Model.Customer.FirstName} {Model.Customer.LastName}"
        : "Unknown Customer";

    var items = Model.OrderItems?.ToList()
        ?? new List<RestaurantManagementSystem.Models.OrderItem>();
}


<div class="order-details-page">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left"></i>
                    Orders

                </a>

                <span class="text-muted">/</span>

                <span class="text-muted">
                    Details
                </span>

            </div>

            <h1 class="fw-bold mb-1">
                Order #@Model.OrderId
            </h1>

            <p class="text-muted mb-0">
                Review order information and purchased items.
            </p>

        </div>


        <!-- Status -->

        <div>

            @if (Model.Status == "Pending")
            {
                <span class="badge rounded-pill px-4 py-2 bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-clock me-1"></i>
                    Pending
                </span>
            }
            else if (Model.Status == "Completed")
            {
                <span class="badge rounded-pill px-4 py-2 bg-success-subtle text-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Completed
                </span>
            }
            else if (Model.Status == "Cancelled")
            {
                <span class="badge rounded-pill px-4 py-2 bg-danger-subtle text-danger">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancelled
                </span>
            }
            else
            {
                <span class="badge rounded-pill px-4 py-2 bg-secondary-subtle text-secondary">
                    @Model.Status
                </span>
            }

        </div>

    </div>


    <!-- ================= ORDER INFORMATION ================= -->

    <div class="row g-4 mb-4">

        <!-- Order Info -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Order Information
                    </h5>

                    <small class="text-muted">
                        Basic information about this order
                    </small>

                </div>


                <div class="card-body px-4">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <small class="text-muted d-block mb-1">
                                Order ID
                            </small>

                            <span class="fw-bold">
                                #@Model.OrderId
                            </span>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block mb-1">
                                Order Date
                            </small>

                            <span class="fw-semibold">
                                @Model.OrderDate.ToString("dd MMM yyyy")
                            </span>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block mb-1">
                                Order Time
                            </small>

                            <span class="fw-semibold">
                                @Model.OrderDate.ToString("hh:mm tt")
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Customer Info -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Customer
                    </h5>

                    <small class="text-muted">
                        Customer information
                    </small>

                </div>


                <div class="card-body px-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width:48px;height:48px;background:#fff1eb;color:#ff6333;">

                            <i class="bi bi-person-fill fs-5"></i>

                        </div>


                        <div>

                            <div class="fw-bold">
                                @customerName
                            </div>

                            @if (Model.Customer != null)
                            {
                                <small class="text-muted">
                                    @Model.Customer.Email
                                </small>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= ORDER ITEMS ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Order Items
                    </h5>

                    <small class="text-muted">
                        Products included in this order
                    </small>

                </div>

                <span class="text-muted">
                    @items.Count item(s)
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (items.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead style="background:#f8f9fb;">

                            <tr>

                                <th class="ps-4 py-3">
                                    Product
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th class="text-end pe-4">
                                    Subtotal
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in items)
                            {
                                <tr>

                                    <td class="ps-4">

                                        @if (item.Product != null)
                                        {
                                            <div class="d-flex align-items-center">

                                                <div class="rounded-3 d-flex align-items-center justify-content-center me-3"
                                                     style="width:42px;height:42px;background:#f4f5f7;">

                                                    <i class="bi bi-box-seam text-muted"></i>

                                                </div>

                                                <div>

                                                    <div class="fw-semibold">
                                                        @item.Product.Name
                                                    </div>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Product
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @item.UnitPrice.ToString("0.00")

                                    </td>


                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @item.Quantity
                                        </span>

                                    </td>


                                    <td class="text-end pe-4">

                                        <span class="fw-bold">
                                            @item.SubTotal.ToString("0.00")
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-basket fs-1 text-muted"></i>

                    <h6 class="fw-bold mt-3">
                        No items found
                    </h6>

                    <p class="text-muted mb-0">
                        This order does not contain any items.
                    </p>

                </div>
            }

        </div>


        <!-- Total -->

        <div class="border-top">

            <div class="d-flex justify-content-end align-items-center px-4 py-4">

                <div class="me-4">

                    <span class="text-muted">
                        Order Total
                    </span>

                </div>

                <div>

                    <span class="fs-4 fw-bold">
                        @Model.TotalAmount.ToString("0.00")
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= BACK BUTTON ================= -->

    <div class="mt-4">

        <a asp-area="Admin"
           asp-controller="Orders"
           asp-action="Index"
           class="btn btn-light border">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Orders

        </a>

    </div>

</div>