@model IEnumerable<RestaurantManagementSystem.Models.Order>

@{
    ViewData["Title"] = "Orders";

    var orders = Model?.ToList()
        ?? new List<RestaurantManagementSystem.Models.Order>();

    var totalOrders = orders.Count;

    var pendingOrders = orders.Count(o =>
        o.Status == "Pending");

    var completedOrders = orders.Count(o =>
        o.Status == "Completed");

    var totalRevenue = orders
        .Where(o =>
            o.Status != "Cart" &&
            o.Status != "Cancelled")
        .Sum(o => o.TotalAmount);
}


<div class="orders-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                Orders
            </h1>

            <p class="text-muted mb-0">
                Monitor and manage all restaurant orders.
            </p>

        </div>

    </div>


    <!-- ================= STATISTICS ================= -->

    <div class="row g-3 mb-4">

        <!-- Total Orders -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Total Orders
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalOrders
                        </h3>

                        <small class="text-muted">
                            All orders
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#fff1eb;">

                        <i class="bi bi-receipt-cutoff fs-4"
                           style="color:#ff6333;">
                        </i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Pending
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @pendingOrders
                        </h3>

                        <small class="text-muted">
                            Awaiting processing
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#fff8e6;">

                        <i class="bi bi-clock-history fs-4 text-warning">
                        </i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Completed
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @completedOrders
                        </h3>

                        <small class="text-muted">
                            Successfully completed
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#edf9f1;">

                        <i class="bi bi-check-circle fs-4 text-success">
                        </i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Revenue -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Total Revenue
                        </small>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalRevenue.ToString("0.00")
                        </h3>

                        <small class="text-muted">
                            From active orders
                        </small>

                    </div>

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#eef5ff;">

                        <i class="bi bi-cash-stack fs-4 text-primary">
                        </i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= ORDER HISTORY ================= -->

    <div class="card border-0 shadow-sm">


        <!-- Card Header -->

        <div class="card-header bg-white border-0 pt-4 px-4 pb-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Order History
                    </h5>

                    <small class="text-muted">
                        View all customer orders
                    </small>

                </div>


                <!-- Search -->

                <div class="orders-search">

                    <i class="bi bi-search orders-search-icon"></i>

                    <input type="text"
                           id="orderSearch"
                           class="orders-search-input"
                           placeholder="Search by order ID, customer..." />

                    <button type="button"
                            id="clearOrderSearch"
                            class="orders-search-clear"
                            aria-label="Clear search">

                        <i class="bi bi-x"></i>

                    </button>

                </div>

            </div>

        </div>


        <!-- Card Body -->

        <div class="card-body p-0">

            @if (orders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0"
                           id="ordersTable">

                        <thead style="background:#f8f9fb;">

                            <tr>

                                <th class="ps-4 py-3">
                                    Order
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var order in orders)
                            {
                                <tr>

                                    <!-- Order -->

                                    <td class="ps-4">

                                        <span class="fw-bold">
                                            #@order.OrderId
                                        </span>

                                    </td>


                                    <!-- Customer -->

                                    <td>

                                        @if (order.Customer != null)
                                        {
                                            <div class="d-flex align-items-center">

                                                <div class="rounded-circle d-flex align-items-center justify-content-center me-2"
                                                     style="width:40px;height:40px;background:#fff1eb;color:#ff6333;">

                                                    <i class="bi bi-person-fill"></i>

                                                </div>

                                                <div>

                                                    <div class="fw-semibold">

                                                        @order.Customer.FirstName
                                                        @order.Customer.LastName

                                                    </div>

                                                    <small class="text-muted">

                                                        @order.Customer.Email

                                                    </small>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Customer
                                            </span>
                                        }

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        <div class="fw-semibold">

                                            @order.OrderDate.ToString("dd MMM yyyy")

                                        </div>

                                        <small class="text-muted">

                                            @order.OrderDate.ToString("hh:mm tt")

                                        </small>

                                    </td>


                                    <!-- Total -->

                                    <td>

                                        <span class="fw-bold">

                                            @order.TotalAmount.ToString("0.00")

                                        </span>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (order.Status == "Pending")
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-warning-subtle text-warning-emphasis">
                                                Pending
                                            </span>
                                        }
                                        else if (order.Status == "Completed")
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-success-subtle text-success">
                                                Completed
                                            </span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-danger-subtle text-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else if (order.Status == "Cart")
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-secondary-subtle text-secondary">
                                                Cart
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-info-subtle text-info">
                                                @order.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->

                                    <td class="text-end pe-4">

                                        <a asp-area="Admin"
                                           asp-controller="Orders"
                                           asp-action="Details"
                                           asp-route-id="@order.OrderId"
                                           class="btn btn-sm btn-light border">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:#f4f5f7;">

                        <i class="bi bi-receipt fs-2 text-muted">
                        </i>

                    </div>

                    <h5 class="fw-bold mb-2">
                        No orders yet
                    </h5>

                    <p class="text-muted mb-0">
                        Orders will appear here once customers place them.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const searchInput =
            document.getElementById("orderSearch");

        const clearButton =
            document.getElementById("clearOrderSearch");


        if (searchInput) {

            searchInput.addEventListener("input", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    document.querySelectorAll(
                        "#ordersTable tbody tr"
                    );


                rows.forEach(function (row) {

                    const rowText =
                        row.innerText.toLowerCase();

                    row.style.display =
                        rowText.includes(searchValue)
                            ? ""
                            : "none";

                });


                if (clearButton) {

                    clearButton.style.display =
                        searchValue.length > 0
                            ? "flex"
                            : "none";

                }

            });

        }


        if (clearButton) {

            clearButton.addEventListener("click", function () {

                searchInput.value = "";

                searchInput.dispatchEvent(
                    new Event("input")
                );

                searchInput.focus();

            });

        }

    </script>

}