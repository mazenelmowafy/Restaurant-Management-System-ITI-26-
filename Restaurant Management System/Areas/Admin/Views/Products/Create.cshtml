@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="products-page">

    <!-- ================= HEADER ================= -->

    <div class="products-header">

        <div>
            <h1>Add Product</h1>

            <p>
                Add a new product to your restaurant menu.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-light border">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Products

        </a>

    </div>


    <!-- ================= FORM CARD ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 px-4 pt-4">

            <h5 class="fw-bold mb-1">
                Product Information
            </h5>

            <p class="text-muted mb-0">
                Enter the details of the new product.
            </p>

        </div>


        <div class="card-body px-4 py-4">

            <form asp-area="Admin"
                  asp-controller="Products"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- Validation Summary -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">


                    <!-- Product Name -->

                    <div class="col-md-8">

                        <label asp-for="Name"
                               class="form-label fw-semibold">

                            Product Name

                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter product name..." />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Price -->

                    <div class="col-md-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">

                            Price

                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control"
                                   placeholder="0.00"
                                   type="number"
                                   step="0.01"
                                   min="0" />

                            <span class="input-group-text">
                                EGP
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Category -->

                    <div class="col-md-6">

                        <label asp-for="Category"
                               class="form-label fw-semibold">

                            Category

                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Burger, Pizza, Drinks..." />

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Admin -->

                    <div class="col-md-6">

                        <label asp-for="AdminId"
                               class="form-label fw-semibold">

                            Assigned Admin

                        </label>

                        <select asp-for="AdminId"
                                asp-items="ViewBag.AdminId"
                                class="form-select">

                            <option value="">
                                Select an admin
                            </option>

                        </select>

                        <span asp-validation-for="AdminId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Description -->

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the product...">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Availability -->

                    <div class="col-md-6">

                        <div class="form-check form-switch mt-2">

                            <input asp-for="IsAvailable"
                                   class="form-check-input"
                                   role="switch" />

                            <label asp-for="IsAvailable"
                                   class="form-check-label fw-semibold">

                                Product is available

                            </label>

                        </div>

                        <small class="text-muted">
                            Customers can order this product when it is available.
                        </small>

                    </div>


                    <!-- Image Upload -->

                    <div class="col-12">

                        <label for="ImageFile"
                               class="form-label fw-semibold">

                            Product Image

                        </label>

                        <input type="file"
                               name="ImageFile"
                               id="ImageFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.gif" />

                        <div class="form-text">
                            Supported formats: JPG, JPEG, PNG, GIF. Maximum size: 5 MB.
                        </div>

                        <span asp-validation-for="ImageFileName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Image Preview -->

                    <div class="col-12">

                        <div id="imagePreview"
                             class="d-none">

                            <p class="fw-semibold mb-2">
                                Image Preview
                            </p>

                            <img id="previewImage"
                                 src="#"
                                 alt="Product Preview"
                                 style="max-width:220px;
                            max-height:180px;
                            object-fit:cover;
                            border-radius:12px;
                            border:1px solid #e1e5eb;" />

                        </div>

                    </div>

                </div>


                <!-- ================= ACTIONS ================= -->

                <div class="border-top mt-4 pt-4 d-flex justify-content-end gap-2">

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-light border">

                        Cancel

                    </a>

                    <button type="submit"
                            class="admin-primary-btn">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        const imageInput =
            document.getElementById("ImageFile");

        const previewContainer =
            document.getElementById("imagePreview");

        const previewImage =
            document.getElementById("previewImage");


        if (imageInput) {

            imageInput.addEventListener("change", function () {

                const file = this.files[0];

                if (!file) {

                    previewContainer.classList.add("d-none");

                    previewImage.src = "#";

                    return;
                }


                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/gif"
                ];


                if (!allowedTypes.includes(file.type)) {

                    previewContainer.classList.add("d-none");

                    this.value = "";

                    return;
                }


                const reader =
                    new FileReader();


                reader.onload = function (event) {

                    previewImage.src =
                        event.target.result;

                    previewContainer.classList.remove("d-none");

                };


                reader.readAsDataURL(file);

            });

        }

    </script>

}