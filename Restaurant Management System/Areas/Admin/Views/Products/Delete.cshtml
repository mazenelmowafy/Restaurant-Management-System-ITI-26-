@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";

    var adminName = Model.Admin != null
        ? $"{Model.Admin.FirstName} {Model.Admin.LastName}"
        : "Not assigned";
}

<div class="products-page">

    <!-- ================= HEADER ================= -->

    <div class="products-header">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left"></i>
                    Products

                </a>

                <span class="text-muted">/</span>

                <span class="text-muted">
                    Delete
                </span>

            </div>

            <h1>Delete Product</h1>

            <p>
                Review the product before permanently deleting it.
            </p>

        </div>

    </div>


    <!-- ================= WARNING ================= -->

    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-start mb-4">

        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

        <div>

            <h6 class="fw-bold mb-1">
                Are you sure you want to delete this product?
            </h6>

            <p class="mb-0">
                This action cannot be undone. The product and its image
                will be permanently removed.
            </p>

        </div>

    </div>


    <!-- ================= PRODUCT CARD ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row g-4 align-items-center">


                <!-- Product Image -->

                <div class="col-md-4">

                    @if (!string.IsNullOrEmpty(Model.ImageFileName))
                    {
                        <img src="~/images/products/@Model.ImageFileName"
                             alt="@Model.Name"
                             class="w-100"
                             style="
                                height:240px;
                                object-fit:cover;
                                border-radius:14px;
                             " />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center"
                             style="
                                height:240px;
                                background:#f5f6f8;
                                border-radius:14px;
                             ">

                            <i class="bi bi-image fs-1 text-muted"></i>

                        </div>
                    }

                </div>


                <!-- Product Information -->

                <div class="col-md-8">

                    <small class="text-muted">
                        Product #@Model.ProductId
                    </small>

                    <h2 class="fw-bold mt-1 mb-3">
                        @Model.Name
                    </h2>


                    <div class="row g-3">

                        <div class="col-sm-6">

                            <small class="text-muted d-block mb-1">
                                Category
                            </small>

                            <span class="fw-semibold">
                                @Model.Category
                            </span>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-muted d-block mb-1">
                                Price
                            </small>

                            <span class="fw-bold"
                                  style="color:#ff6333;">

                                @Model.Price.ToString("0.00")
                                EGP

                            </span>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-muted d-block mb-1">
                                Assigned Admin
                            </small>

                            <span class="fw-semibold">
                                @adminName
                            </span>

                        </div>


                        <div class="col-sm-6">

                            <small class="text-muted d-block mb-1">
                                Availability
                            </small>

                            @if (Model.IsAvailable)
                            {
                                <span class="product-status available">

                                    <i class="bi bi-check-circle-fill"></i>
                                    Available

                                </span>
                            }
                            else
                            {
                                <span class="product-status unavailable">

                                    <i class="bi bi-x-circle-fill"></i>
                                    Unavailable

                                </span>
                            }

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="mt-4">

                            <small class="text-muted d-block mb-1">
                                Description
                            </small>

                            <p class="mb-0">
                                @Model.Description
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================= ACTIONS ================= -->

        <div class="card-footer bg-white border-top px-4 py-3">

            <div class="d-flex justify-content-end gap-2">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light border">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancel

                </a>


                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Delete"
                      asp-route-id="@Model.ProductId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash3 me-1"></i>
                        Delete Product

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>