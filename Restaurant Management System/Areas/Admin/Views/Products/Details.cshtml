@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";

    var adminName = Model.Admin != null
        ? $"{Model.Admin.FirstName} {Model.Admin.LastName}"
        : "Not assigned";
}

<div class="products-page">

    <!-- ================= HEADER ================= -->

    <div class="products-header">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left"></i>
                    Products

                </a>

                <span class="text-muted">/</span>

                <span class="text-muted">
                    Details
                </span>

            </div>

            <h1>Product Details</h1>

            <p>
                View complete information about this product.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Edit"
               asp-route-id="@Model.ProductId"
               class="admin-primary-btn">

                <i class="bi bi-pencil me-1"></i>
                Edit Product

            </a>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-light border">

                Back

            </a>

        </div>

    </div>


    <!-- ================= PRODUCT DETAILS ================= -->

    <div class="row g-4">

        <!-- Product Image -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    @if (!string.IsNullOrEmpty(Model.ImageFileName))
                    {
                        <img src="~/images/products/@Model.ImageFileName"
                             alt="@Model.Name"
                             class="w-100"
                             style="
                        height:380px;
                        object-fit:cover;
                        border-radius:14px;
                        " />
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center"
                             style="
                            height:380px;
                            background:#f5f6f8;
                            border-radius:14px;
                            ">

                            <i class="bi bi-image fs-1 text-muted"></i>

                            <span class="text-muted mt-2">
                                No image available
                            </span>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Product Information -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Product #@Model.ProductId
                            </small>

                            <h2 class="fw-bold mt-1 mb-0">
                                @Model.Name
                            </h2>

                        </div>


                        <!-- Availability -->
                        @if (Model.IsAvailable)
                        {
                            <span class="product-status available">

                                <i class="bi bi-check-circle-fill"></i>

                                Available

                            </span>
                        }
                        else
                        {
                            <span class="product-status unavailable">

                                <i class="bi bi-x-circle-fill"></i>

                                Unavailable

                            </span>
                        }

                    </div>

                </div>


                <div class="card-body px-4">

                    <!-- Price -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Price
                        </small>

                        <span class="fs-2 fw-bold"
                              style="color:#ff6333;">

                            @Model.Price.ToString("0.00")

                        </span>

                        <span class="text-muted">
                            EGP
                        </span>

                    </div>


                    <hr />


                    <!-- Category -->

                    <div class="row g-4 mt-1">

                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Category
                            </small>

                            <span class="fw-semibold">
                                @Model.Category
                            </span>

                        </div>


                        <!-- Admin -->

                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Assigned Admin
                            </small>

                            <div class="d-flex align-items-center">

                                <div class="rounded-circle d-flex align-items-center justify-content-center me-2"
                                     style="
                                    width:36px;
                                    height:36px;
                                    background:#fff1eb;
                                    color:#ff6333;
                                    ">

                                    <i class="bi bi-person-fill"></i>

                                </div>

                                <span class="fw-semibold">
                                    @adminName
                                </span>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- Description -->

                    <div>

                        <small class="text-muted d-block mb-2">
                            Description
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mb-0"
                               style="line-height:1.8;">

                                @Model.Description

                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No description available.
                            </p>
                        }

                    </div>

                </div>


                <!-- Footer -->

                <div class="card-footer bg-white border-0 px-4 pb-4">

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Delete"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-outline-danger">

                        <i class="bi bi-trash3 me-1"></i>
                        Delete Product

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>