@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    // Layout = "_AdminLayout"; // Point this to the real Admin layout once it exists
}

<h1>Edit Product</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ImageFileName" />

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price" class="control-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Category" class="control-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AdminId" class="control-label"></label>
        <select asp-for="AdminId" class="form-control" asp-items="ViewBag.AdminId">
            <option value="">-- Select Admin --</option>
        </select>
        <span asp-validation-for="AdminId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="control-label">Current Image</label>
        <div>
            @if (!string.IsNullOrEmpty(Model.ImageFileName))
            {
                <img src="~/images/products/@Model.ImageFileName" alt="@Model.Name" width="120" />
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="RemoveImage" id="RemoveImage" value="true" />
                    <label class="form-check-label" for="RemoveImage">Remove current image</label>
                </div>
            }
            else
            {
                <span class="text-muted">No image set</span>
            }
        </div>
    </div>

    <div class="form-group">
        <label for="ImageFile" class="control-label">Replace Image</label>
        <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
        <span asp-validation-for="ImageFileName" class="text-danger"></span>
        <small class="form-text text-muted">Optional. Uploading a new image replaces the current one.</small>
    </div>

    <div class="form-group form-check">
        <label class="form-check-label">
            <input class="form-check-input" asp-for="IsAvailable" /> @Html.DisplayNameFor(model => model.IsAvailable)
        </label>
    </div>

    <div class="form-group">
        <input type="submit" value="Save Changes" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to Products</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
