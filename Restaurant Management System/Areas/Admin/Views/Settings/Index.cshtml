@{
    ViewData["Title"] = "Settings";
}

<div class="products-page">

    <div class="products-header">

        <div>
            <h1>Settings</h1>

            <p>
                Manage your admin panel preferences.
            </p>
        </div>

    </div>


    <div class="row g-4">

        <!-- General Settings -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        General Settings
                    </h5>

                    <p class="text-muted mb-0">
                        Basic restaurant settings.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Restaurant Name
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Restaurant Management System" />

                    </div>


                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Currency
                        </label>

                        <select class="form-select">

                            <option selected>
                                EGP - Egyptian Pound
                            </option>

                            <option>
                                USD - US Dollar
                            </option>

                        </select>

                    </div>


                    <button class="admin-primary-btn">
                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes
                    </button>

                </div>

            </div>

        </div>


        <!-- Admin Preferences -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Admin Preferences
                    </h5>

                    <p class="text-muted mb-0">
                        Customize your admin experience.
                    </p>

                </div>


                <div class="card-body px-4">

                    <div class="form-check form-switch mb-4">

                        <input class="form-check-input"
                               type="checkbox"
                               checked />

                        <label class="form-check-label fw-semibold">
                            Enable notifications
                        </label>

                        <small class="text-muted d-block">
                            Receive notifications about restaurant activity.
                        </small>

                    </div>


                    <div class="form-check form-switch mb-4">

                        <input class="form-check-input"
                               type="checkbox"
                               checked />

                        <label class="form-check-label fw-semibold">
                            Show order notifications
                        </label>

                        <small class="text-muted d-block">
                            Show alerts when new orders are received.
                        </small>

                    </div>


                    <div class="form-check form-switch">

                        <input class="form-check-input"
                               type="checkbox"
                               checked />

                        <label class="form-check-label fw-semibold">
                            Show unavailable products
                        </label>

                        <small class="text-muted d-block">
                            Keep unavailable products visible in the admin panel.
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>