@model Restaurant_Management_System.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="rms-auth-page">

    <div class="rms-auth-card rms-auth-register">

        <div class="rms-auth-brand">

            <div class="rms-auth-logo">
                <i class="bi bi-shop"></i>
            </div>

            <div>
                <strong>Restaurant</strong>
                <span>GOOD FOOD • GOOD MOOD</span>
            </div>

        </div>


        <div class="rms-auth-heading">

            <div class="rms-details-label">
                JOIN US
            </div>

            <h1>Create Account.</h1>

            <p>
                Create your account and start ordering your favorite meals.
            </p>

        </div>


        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="rms-auth-validation">
            </div>


            <!-- Name -->

            <div class="rms-auth-row">

                <div class="rms-auth-field">

                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-person"></i>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="First name" />

                    </div>

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>


                <div class="rms-auth-field">

                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-person"></i>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Last name" />

                    </div>

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- Email -->

            <div class="rms-auth-field">

                <label asp-for="Email">
                    Email Address
                </label>

                <div class="rms-input-wrap">

                    <i class="bi bi-envelope"></i>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email" />

                </div>

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- Password -->

            <div class="rms-auth-row">

                <div class="rms-auth-field">

                    <label asp-for="Password">
                        Password
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-lock"></i>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="rms-auth-field">

                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-shield-lock"></i>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- Phone -->

            <div class="rms-auth-field">

                <label asp-for="Phone">
                    Phone Number
                </label>

                <div class="rms-input-wrap">

                    <i class="bi bi-telephone"></i>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter your phone number" />

                </div>

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>

            </div>


            <!-- Street -->

            <div class="rms-auth-field">

                <label asp-for="Street">
                    Street Address
                </label>

                <div class="rms-input-wrap">

                    <i class="bi bi-geo-alt"></i>

                    <input asp-for="Street"
                           class="form-control"
                           placeholder="Enter your street" />

                </div>

                <span asp-validation-for="Street"
                      class="text-danger">
                </span>

            </div>


            <!-- City + Zip -->

            <div class="rms-auth-row">

                <div class="rms-auth-field">

                    <label asp-for="City">
                        City
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-building"></i>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="City" />

                    </div>

                    <span asp-validation-for="City"
                          class="text-danger">
                    </span>

                </div>


                <div class="rms-auth-field">

                    <label asp-for="ZipCode">
                        Zip Code
                    </label>

                    <div class="rms-input-wrap">

                        <i class="bi bi-mailbox"></i>

                        <input asp-for="ZipCode"
                               class="form-control"
                               placeholder="Zip code" />

                    </div>

                    <span asp-validation-for="ZipCode"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- Submit -->

            <button type="submit"
                    class="rms-auth-submit">

                <span>Create Account</span>

                <i class="bi bi-arrow-right"></i>

            </button>

        </form>


        <div class="rms-auth-footer">

            <span>
                Already have an account?
            </span>

            <a asp-controller="Account"
               asp-action="Login">

                Sign In

            </a>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}