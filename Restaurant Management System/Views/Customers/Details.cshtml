@model RestaurantManagementSystem.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<h1>Customer Details</h1>

<div>
    <h4>Customer</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>

        <dt class="col-sm-2">Street</dt>
        <dd class="col-sm-10">@Model.Street</dd>

        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>

        <dt class="col-sm-2">Zip Code</dt>
        <dd class="col-sm-10">@Model.ZipCode</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.CustomerID"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Customers
    </a>
</div>