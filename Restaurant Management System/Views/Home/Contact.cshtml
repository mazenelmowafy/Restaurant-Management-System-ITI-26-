@{
    ViewData["Title"] = "Contact Us";
}

<div class="container rms-container rms-contact-page">

    <!-- Header -->

    <div class="rms-contact-header">

        <div class="rms-details-label">
            GET IN TOUCH
        </div>

        <h1>
            We'd Love To Hear From You.
        </h1>

        <p>
            Whether you have a question, feedback, or simply want to say hello,
            our team is always happy to hear from you.
        </p>

    </div>


    <!-- Contact Cards -->

    <div class="rms-contact-grid">

        <div class="rms-contact-card">

            <div class="rms-contact-icon">
                <i class="bi bi-geo-alt"></i>
            </div>

            <h5>Visit Us</h5>

            <p>
                Cairo, Egypt
            </p>

        </div>


        <div class="rms-contact-card">

            <div class="rms-contact-icon">
                <i class="bi bi-telephone"></i>
            </div>

            <h5>Call Us</h5>

            <p>
                +20 100 000 0000
            </p>

        </div>


        <div class="rms-contact-card">

            <div class="rms-contact-icon">
                <i class="bi bi-envelope"></i>
            </div>

            <h5>Email Us</h5>

            <p>
                info@restaurant.com
            </p>

        </div>

    </div>


    <!-- Contact Content -->

    <div class="rms-contact-content">

        <!-- Contact Information -->

        <div class="rms-contact-info">

            <div class="rms-details-label">
                CONTACT INFORMATION
            </div>

            <h3>
                Let's Talk
            </h3>

            <p>
                Have a question about our menu or your order?
                Send us a message and we'll get back to you.
            </p>


            <div class="rms-contact-info-row">

                <i class="bi bi-geo-alt"></i>

                <div>
                    <span>Address</span>
                    <strong>Cairo, Egypt</strong>
                </div>

            </div>


            <div class="rms-contact-info-row">

                <i class="bi bi-telephone"></i>

                <div>
                    <span>Phone</span>
                    <strong>+20 100 000 0000</strong>
                </div>

            </div>


            <div class="rms-contact-info-row">

                <i class="bi bi-envelope"></i>

                <div>
                    <span>Email</span>
                    <strong>info@restaurant.com</strong>
                </div>

            </div>


            <div class="rms-contact-info-row">

                <i class="bi bi-clock"></i>

                <div>
                    <span>Opening Hours</span>
                    <strong>10:00 AM — 12:00 AM</strong>
                </div>

            </div>

        </div>


        <!-- Contact Form -->

        <div class="rms-contact-form">

            <div class="rms-details-label">
                SEND A MESSAGE
            </div>

            <h3>
                How Can We Help?
            </h3>

            <p>
                Fill in the form below and we'll get back to you as soon as possible.
            </p>


            <form>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Your Name
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter your name" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="Enter your email" />

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Subject
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="What is this about?" />

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Message
                        </label>

                        <textarea class="form-control"
                                  placeholder="Write your message..."></textarea>

                    </div>


                    <div class="col-12">

                        <button type="submit" class="contact-send-btn">

                            <span>Send Message</span>

                            <span class="contact-send-icon">
                                <i class="bi bi-arrow-up-right"></i>
                            </span>

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>