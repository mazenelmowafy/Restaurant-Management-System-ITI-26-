@{
    ViewData["Title"] = "Home";
}

<section class="rms-hero">
    <div class="container position-relative">
        <div class="rms-kicker">Fine Dining, Simply Served</div>
        <h1>Welcome to <span class="rms-hero-logo" role="img" aria-label="R restaurant logo"><span>R</span></span></h1>
        <hr class="rms-divider" />
        <p class="lead">
            Discover a menu crafted with care, order in a few clicks, and let us
            take care of the rest &mdash; from kitchen to table.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Products" asp-action="Index" class="btn-silver">
                View Menu
            </a>
            <a asp-controller="Orders" asp-action="Index" class="btn-outline-silver">
                My Orders
            </a>
        </div>
    </div>
</section>

<div class="container rms-container">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="rms-surface p-4 h-100">
                <div style="font-size:1.8rem; color:var(--rms-silver);">&#127860;</div>
                <h5 class="mt-3">Curated Menu</h5>
                <p class="text-muted small mb-0">Seasonal dishes, plated with intention and served with pride.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rms-surface p-4 h-100">
                <div style="font-size:1.8rem; color:var(--rms-silver);">&#128722;</div>
                <h5 class="mt-3">Effortless Ordering</h5>
                <p class="text-muted small mb-0">Add your favorites to the cart and check out in moments.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rms-surface p-4 h-100">
                <div style="font-size:1.8rem; color:var(--rms-silver);">&#9201;</div>
                <h5 class="mt-3">Track Every Order</h5>
                <p class="text-muted small mb-0">Follow your order status from confirmation to the table.</p>
            </div>
        </div>
    </div>
</div>
