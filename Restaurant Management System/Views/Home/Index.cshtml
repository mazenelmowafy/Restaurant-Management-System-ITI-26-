@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    <p>Welcome to Restaurant Management System</p>

    <div class="mt-4">
        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Products
