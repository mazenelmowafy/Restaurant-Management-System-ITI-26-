@model RestaurantManagementSystem.Models.OrderItem

@{
    ViewData["Title"] = "Delete Order Item";
}

<h1>Delete Order Item</h1>

<h3>Are you sure you want to delete this order item?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Order
    </dt>
    <dd class="col-sm-10">
        Order #@Model.OrderId
    </dd>

    <dt class="col-sm-2">
        Customer
    </dt>
    <dd class="col-sm-10">
        @Model.Order?.Customer?.FirstName
        @Model.Order?.Customer?.LastName
    </dd>

    <dt class="col-sm-2">
        Product
    </dt>
    <dd class="col-sm-10">
        @Model.Product?.Name
    </dd>

    <dt class="col-sm-2">
        Quantity
    </dt>
    <dd class="col-sm-10">
        @Model.Quantity
    </dd>

    <dt class="col-sm-2">
        Unit Price
    </dt>
    <dd class="col-sm-10">
        @Model.UnitPrice
    </dd>

    <dt class="col-sm-2">
        Sub Total
    </dt>
    <dd class="col-sm-10">
        @Model.SubTotal
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="OrderId" />

    <input type="hidden"
           asp-for="ProductId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Order Items
    </a>

</form>