@model RestaurantManagementSystem.Models.OrderItem

@{
    ViewData["Title"] = "Order Item Details";
}

<h1>Order Item Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Order
    </dt>
    <dd class="col-sm-10">
        Order #@Model.OrderId
    </dd>

    <dt class="col-sm-2">
        Customer
    </dt>
    <dd class="col-sm-10">
        @Model.Order?.Customer?.FirstName
        @Model.Order?.Customer?.LastName
    </dd>

    <dt class="col-sm-2">
        Product
    </dt>
    <dd class="col-sm-10">
        @Model.Product?.Name
    </dd>

    <dt class="col-sm-2">
        Quantity
    </dt>
    <dd class="col-sm-10">
        @Model.Quantity
    </dd>

    <dt class="col-sm-2">
        Unit Price
    </dt>
    <dd class="col-sm-10">
        @Model.UnitPrice
    </dd>

    <dt class="col-sm-2">
        Sub Total
    </dt>
    <dd class="col-sm-10">
        @Model.SubTotal
    </dd>

</dl>

<div>
    <a asp-action="Edit"
       asp-route-orderId="@Model.OrderId"
       asp-route-productId="@Model.ProductId"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Order Items
    </a>
</div>