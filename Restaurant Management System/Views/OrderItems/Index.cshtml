@model IEnumerable<RestaurantManagementSystem.Models.OrderItem>

@{
    ViewData["Title"] = "Order Items";
}

<h1>Order Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Order Item</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Order</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Sub Total</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.OrderId
                </td>

                <td>
                    @item.Order?.Customer?.FirstName
                    @item.Order?.Customer?.LastName
                </td>

                <td>
                    @item.Product?.Name
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.UnitPrice
                </td>

                <td>
                    @item.SubTotal
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-orderId="@item.OrderId"
                       asp-route-productId="@item.ProductId">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-orderId="@item.OrderId"
                       asp-route-productId="@item.ProductId">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-orderId="@item.OrderId"
                       asp-route-productId="@item.ProductId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>