@model RestaurantManagementSystem.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Your Cart";
    var cart = ViewBag.Cart as RestaurantManagementSystem.Models.Order;
}

<div class="cart-page">

    <div class="container">

        <!-- Page Header -->

        <div class="cart-page-header">

            <div>
                <span class="section-eyebrow">
                    YOUR ORDER
                </span>

                <h1>
                    Your <span>Cart.</span>
                </h1>

                <p>
                    Review your selected dishes before placing your order.
                </p>
            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="cart-back-link">

                <i class="bi bi-arrow-left"></i>

                Continue Shopping

            </a>

        </div>


        @if (cart == null || cart.OrderItems == null || !cart.OrderItems.Any())
        {
            <!-- Empty Cart -->

            <div class="cart-empty">

                <div class="cart-empty-icon">
                    <i class="bi bi-bag-x"></i>
                </div>

                <h2>
                    Your cart is empty
                </h2>

                <p>
                    Looks like you haven't added anything yet.
                    Explore our menu and find something delicious.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="cart-primary-btn">

                    Browse Our Menu

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>
        }
        else
        {
            <div class="row g-4 align-items-start">

                <!-- Cart Items -->

                <div class="col-lg-8">

                    <div class="cart-items-card">

                        <div class="cart-items-header">

                            <div>
                                <h2>
                                    Selected Items
                                </h2>

                                <span>
                                    @cart.OrderItems.Count item(s)
                                </span>
                            </div>

                        </div>


                        @foreach (var item in cart.OrderItems)
                        {
                            <div class="cart-item">

                                <!-- Product Image -->

                                <div class="cart-item-image">

                                    @if (!string.IsNullOrEmpty(item.Product.ImageFileName))
                                    {
                                        <img src="~/images/products/@item.Product.ImageFileName"
                                             alt="@item.Product.Name" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-egg-fried"></i>
                                    }

                                </div>


                                <!-- Product Info -->

                                <div class="cart-item-info">

                                    <span class="cart-item-category">
                                        @item.Product.Category
                                    </span>

                                    <h3>
                                        @item.Product.Name
                                    </h3>

                                    <p>
                                        @item.Product.Description
                                    </p>

                                </div>

                                <!-- Actions -->

                                <div class="cart-item-actions">

                                    <!-- Quantity -->

                                    <div class="cart-item-quantity">

                                        <span>Quantity</span>

                                        <div class="quantity-control">

                                            <form asp-action="DecreaseQuantity" method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="orderId"
                                                       value="@item.OrderId" />

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />

                                                <button type="submit"
                                                        class="quantity-btn"
                                                        aria-label="Decrease quantity">

                                                    <i class="bi bi-dash"></i>

                                                </button>

                                            </form>


                                            <strong>
                                                @item.Quantity
                                            </strong>


                                            <form asp-action="IncreaseQuantity" method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="orderId"
                                                       value="@item.OrderId" />

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />

                                                <button type="submit"
                                                        class="quantity-btn"
                                                        aria-label="Increase quantity">

                                                    <i class="bi bi-plus"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </div>


                                    <!-- Delete -->

                                    <form asp-action="RemoveFromCart"
                                          method="post"
                                          class="remove-cart-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="orderId"
                                               value="@item.OrderId" />

                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="remove-cart-btn"
                                                title="Remove from cart">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </form>

                                </div>
                                

                            </div>
                        }

                    </div>

                </div>


                <!-- Order Summary -->

                <div class="col-lg-4">

                    <div class="cart-summary-card">

                        <div class="cart-summary-header">

                            <span>
                                ORDER SUMMARY
                            </span>

                            <h2>
                                Your Total
                            </h2>

                        </div>


                        <div class="cart-summary-row">

                            <span>
                                Items
                            </span>

                            <strong>
                                @cart.OrderItems.Sum(i => i.Quantity)
                            </strong>

                        </div>


                        <div class="cart-summary-row">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                @cart.TotalAmount.ToString("0.00") EGP
                            </strong>

                        </div>


                        <div class="cart-summary-divider"></div>


                        <div class="cart-summary-total">

                            <span>
                                Total
                            </span>

                            <strong>
                                @cart.TotalAmount.ToString("0.00") EGP
                            </strong>

                        </div>


                        <!-- Confirm Order -->

                        <form asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   asp-for="CustomerId" />


                            @for (int i = 0; i < Model.productIds.Count; i++)
                            {
                                <input type="hidden"
                                       name="productIds"
                                       value="@Model.productIds[i]" />
                            }


                            @for (int i = 0; i < Model.quantities.Count; i++)
                            {
                                <input type="hidden"
                                       name="quantities"
                                       value="@Model.quantities[i]" />
                            }


                            <button type="submit"
                                    class="cart-confirm-btn">

                                Place Order

                                <i class="bi bi-arrow-right"></i>

                            </button>

                        </form>


                        <a asp-controller="Products"
                           asp-action="Index"
                           class="cart-continue-btn">

                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>