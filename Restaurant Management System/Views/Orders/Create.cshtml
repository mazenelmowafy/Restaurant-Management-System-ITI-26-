@model RestaurantManagementSystem.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Create Order";
    var cart = ViewBag.Cart as RestaurantManagementSystem.Models.Order;
}

<div class="container mt-5">

    <h1 class="mb-4">Your Cart</h1>

    @if (cart == null || cart.OrderItems == null || !cart.OrderItems.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Browse Products
        </a>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in cart.OrderItems)
                    {
                        <tr>
                            <td>
                                @item.Product.Name
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                @item.UnitPrice.ToString("C")
                            </td>

                            <td>
                                @item.SubTotal.ToString("C")
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">
                            Total:
                        </th>

                        <th>
                            @cart.TotalAmount.ToString("C")
                        </th>
                    </tr>
                </tfoot>

            </table>

        </div>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="CustomerId" />

            @for (int i = 0; i < Model.productIds.Count; i++)
            {
                <input type="hidden"
                       name="productIds"
                       value="@Model.productIds[i]" />
            }

            @for (int i = 0; i < Model.quantities.Count; i++)
            {
                <input type="hidden"
                       name="quantities"
                       value="@Model.quantities[i]" />
            }

            <button type="submit"
                    class="btn btn-success">
                Confirm Order
            </button>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-secondary ms-2">
                Continue Shopping
            </a>

        </form>
    }
</div>