@model RestaurantManagementSystem.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Add Order";
    var cart = ViewBag.Cart as RestaurantManagementSystem.Models.Order;
}

<div class="container rms-container">
    <div class="rms-page-header">
        <h1>Your Order</h1>
        <a asp-controller="Products" asp-action="Index" class="btn btn-dark-elegant">
            &larr; Continue Browsing
        </a>
    </div>

    @if (cart == null || cart.OrderItems == null || !cart.OrderItems.Any())
    {
        <div class="rms-empty-state rms-surface">
            <div class="rms-empty-icon">&#128722;</div>
            <h5>Your cart is empty</h5>
            <p class="text-muted mb-4">Add a few dishes from the menu to get started.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-silver">
                Browse the Menu
            </a>
        </div>
    }
    else
    {
        <div class="rms-table-wrap mb-4">
            <table class="table rms-table mb-0">
                <thead>
                    <tr>
                        <th>Dish</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cart.OrderItems)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>@item.SubTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th>@cart.TotalAmount.ToString("C")</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <form asp-action="Create" method="post" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CustomerId" />

            @for (int i = 0; i < Model.productIds.Count; i++)
            {
                <input type="hidden" name="productIds" value="@Model.productIds[i]" />
            }

            @for (int i = 0; i < Model.quantities.Count; i++)
            {
                <input type="hidden" name="quantities" value="@Model.quantities[i]" />
            }

            <button type="submit" class="btn-silver">
                Confirm Order
            </button>

            <a asp-controller="Products" asp-action="Index" class="btn btn-dark-elegant">
                Continue Shopping
            </a>
        </form>
    }
</div>
