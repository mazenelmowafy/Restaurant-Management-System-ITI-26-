@model RestaurantManagementSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container rms-container">
    <div class="rms-page-header">
        <h1>Order #@Model.OrderId</h1>
        <span class="badge rms-badge fs-6">@Model.Status</span>
    </div>

    <div class="rms-surface p-4 mb-4">
        <div class="row text-center text-md-start">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="form-label mb-1">Order ID</div>
                <div>#@Model.OrderId</div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="form-label mb-1">Order Date</div>
                <div>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-4">
                <div class="form-label mb-1">Status</div>
                <div>@Model.Status</div>
            </div>
        </div>
    </div>

    <div class="rms-table-wrap mb-4">
        <table class="table rms-table mb-0">
            <thead>
                <tr>
                    <th>Dish</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.SubTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>@Model.TotalAmount.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Payment" asp-action="Index" asp-route-orderId="@Model.OrderId" class="btn-silver">
            Proceed to Payment
        </a>
        <a asp-action="Index" class="btn btn-dark-elegant">
            Back to Orders
        </a>
    </div>
</div>
