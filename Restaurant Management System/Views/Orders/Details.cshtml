@model RestaurantManagementSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="order-details-page">

    <div class="container">

        <!-- Header -->

        <div class="order-details-header">

            <div>

                <span class="section-eyebrow">
                    ORDER DETAILS
                </span>

                <h1>
                    Order <span>#@Model.OrderId</span>
                </h1>

                <p>
                    Review the details of your order.
                </p>

            </div>

            <span class="order-details-status @Model.Status.ToLower()">
                @Model.Status
            </span>

        </div>


        <!-- Order Information -->

        <div class="order-info-card">

            <div class="order-info-item">

                <span>
                    ORDER ID
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>


            <div class="order-info-item">

                <span>
                    ORDER DATE
                </span>

                <strong>
                    @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                </strong>

            </div>


            <div class="order-info-item">

                <span>
                    STATUS
                </span>

                <strong>
                    @Model.Status
                </strong>

            </div>

        </div>


        <div class="order-details-layout">

            <!-- Items -->

            <div class="order-items-card">

                <div class="order-items-header">

                    <div>

                        <span class="section-eyebrow">
                            YOUR ITEMS
                        </span>

                        <h2>
                            Order Summary
                        </h2>

                    </div>

                    <span>
                        @Model.OrderItems.Count item(s)
                    </span>

                </div>


                <div class="order-items-list">

                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="order-detail-item">

                            <div class="order-detail-image">

                                @if (!string.IsNullOrEmpty(item.Product.ImageFileName))
                                {
                                    <img src="~/images/products/@item.Product.ImageFileName"
                                         alt="@item.Product.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-egg-fried"></i>
                                }

                            </div>


                            <div class="order-detail-product">

                                <span class="product-category">
                                    @item.Product.Category
                                </span>

                                <h3>
                                    @item.Product.Name
                                </h3>

                                <p>
                                    @item.Product.Description
                                </p>

                            </div>


                            <div class="order-detail-quantity">

                                <span>
                                    QUANTITY
                                </span>

                                <strong>
                                    × @item.Quantity
                                </strong>

                            </div>


                            <div class="order-detail-price">

                                <span>
                                    @item.UnitPrice.ToString("0.00") EGP
                                </span>

                                <strong>
                                    @item.SubTotal.ToString("0.00") EGP
                                </strong>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- Summary -->

            <div class="order-summary-card">

                <span class="section-eyebrow">
                    ORDER SUMMARY
                </span>

                <h2>
                    Your Total
                </h2>


                <div class="summary-row">

                    <span>
                        Items
                    </span>

                    <strong>
                        @Model.OrderItems.Sum(i => i.Quantity)
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        @Model.TotalAmount.ToString("0.00") EGP
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        @Model.TotalAmount.ToString("0.00") EGP
                    </strong>

                </div>


                @if (Model.Status == "Pending")
                {
                    <a asp-controller="Payment"
                       asp-action="Index"
                       asp-route-orderId="@Model.OrderId"
                       class="order-payment-btn">

                        Proceed to Payment

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }


                <a asp-action="Index"
                   class="order-back-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back to Orders

                </a>

            </div>

        </div>

    </div>

</div>