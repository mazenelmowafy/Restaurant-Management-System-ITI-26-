@model IEnumerable<RestaurantManagementSystem.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Order</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Order Date</th>
            <th>Customer</th>
            <th>Status</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.OrderId
                </td>
                <td>
                    @item.OrderDate
                </td>
                <td>
                    @item.Customer?.FirstName @item.Customer?.LastName
                </td>
                <td>
                    @item.Status
                </td>
                <td>
                    @item.TotalAmount
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.OrderId">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.OrderId">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.OrderId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
