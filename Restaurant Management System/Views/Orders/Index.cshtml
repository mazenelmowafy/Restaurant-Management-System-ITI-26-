@model IEnumerable<RestaurantManagementSystem.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container rms-container">
    <div class="rms-page-header">
        <h1>My Orders</h1>
        <a asp-controller="Products" asp-action="Index" class="btn-silver">
            Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="rms-empty-state rms-surface">
            <div class="rms-empty-icon">&#128221;</div>
            <h5>You don't have any orders yet</h5>
            <p class="text-muted mb-0">Once you place an order, it will show up here.</p>
        </div>
    }
    else
    {
        <div class="rms-table-wrap">
            <table class="table rms-table mb-0">
                <thead>
                    <tr>
                        <th>Order&nbsp;ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total Amount</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.OrderId</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge rms-badge">@order.Status</span></td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-silver">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
