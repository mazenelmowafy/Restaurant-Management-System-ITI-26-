@model IEnumerable<RestaurantManagementSystem.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="orders-page">

    <div class="container">

        <!-- Header -->

        <div class="orders-page-header">

            <div>

                <span class="section-eyebrow">
                    ORDER HISTORY
                </span>

                <h1>
                    My <span>Orders.</span>
                </h1>

                <p>
                    Track your previous orders and view their details.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               class="orders-shopping-btn">

                <i class="bi bi-arrow-left"></i>

                Continue Shopping

            </a>

        </div>


        @if (!Model.Any())
        {
            <!-- Empty Orders -->

            <div class="orders-empty">

                <div class="orders-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h2>
                    No orders yet
                </h2>

                <p>
                    You haven't placed any orders yet.
                    Explore our menu and find something delicious.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="orders-primary-btn">

                    Explore Our Menu

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>
        }
        else
        {
            <!-- Orders -->

            <div class="orders-list">

                @foreach (var order in Model)
                {
                    <div class="order-card">

                        <!-- Order Main Info -->

                        <div class="order-main">

                            <div class="order-icon">

                                <i class="bi bi-receipt"></i>

                            </div>


                            <div class="order-info">

                                <span class="order-label">
                                    ORDER
                                </span>

                                <h2>
                                    #@order.OrderId
                                </h2>

                                <span class="order-date">
                                    <i class="bi bi-calendar3"></i>

                                    @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </span>

                            </div>

                        </div>


                        <!-- Status -->

                        <div class="order-status">

                            <span class="order-label">
                                STATUS
                            </span>

                            <span class="order-status-badge @order.Status.ToLower()">
                                @order.Status
                            </span>

                        </div>


                        <!-- Total -->

                        <div class="order-total">

                            <span class="order-label">
                                TOTAL
                            </span>

                            <strong>
                                @order.TotalAmount.ToString("0.00") EGP
                            </strong>

                        </div>


                        <!-- Details -->

                        <a asp-action="Details"
                           asp-route-id="@order.OrderId"
                           class="order-details-btn">

                            View Details

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>
                }

            </div>
        }

    </div>

</div>