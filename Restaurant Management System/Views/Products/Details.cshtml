@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container rms-container">
    <a asp-action="Index" class="rms-back-link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to Menu
    </a>

    <div class="rms-details-card">
        <div class="rms-details-media">
            @if (!string.IsNullOrEmpty(Model.ImageFileName))
            {
                <img src="~/images/products/@Model.ImageFileName" alt="@Model.Name" />
            }
            else
            {
                <div class="rms-card-img-placeholder">&#127860;</div>
            }

            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <span class="rms-category-badge">@Model.Category</span>
            }
        </div>

        <div class="rms-details-content">
            <div class="rms-details-label">Menu Details</div>
            <h1>@Model.Name</h1>
            <p class="rms-details-description">@Model.Description</p>

            <div class="rms-details-price-row">
                <span>Price</span>
                <strong>@Model.Price.ToString("C")</strong>
            </div>

            <form asp-controller="Products" asp-action="AddToCart" method="post" class="rms-details-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <div class="rms-quantity-field">
                    <label class="form-label" for="quantity">Quantity</label>
                    <input id="quantity" type="number" name="quantity" value="1" min="1" class="form-control" />
                </div>

                <div class="rms-details-actions">
                    <button type="submit" class="btn-silver">Add to Order</button>
                    <a asp-action="Index" class="btn btn-dark-elegant">Continue Browsing</a>
                </div>
            </form>
        </div>
    </div>
</div>
