@model RestaurantManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div>
    <h4>Product</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Name
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            Description
        </dt>
        <dd class="col-sm-10">
            @Model.Description
        </dd>

        <dt class="col-sm-2">
            Available
        </dt>
        <dd class="col-sm-10">
            @Model.IsAvailable
        </dd>

        <dt class="col-sm-2">
            Price
        </dt>
        <dd class="col-sm-10">
            @Model.Price
        </dd>

        <dt class="col-sm-2">
            Category
        </dt>
        <dd class="col-sm-10">
            @Model.Category
        </dd>

        <dt class="col-sm-2">
            Admin
        </dt>
        <dd class="col-sm-10">
            @Model.Admin?.FirstName @Model.Admin?.LastName
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Back to Products
    </a>
</div>