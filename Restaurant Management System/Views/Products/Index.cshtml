@model IEnumerable<RestaurantManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Menu";
}
@if (TempData["CartSuccess"] != null)
{
    <div class="cart-success-alert">
        <i class="bi bi-check-circle-fill"></i>

        <span>
            @TempData["CartSuccess"]
        </span>

        <button type="button"
                class="cart-alert-close"
                onclick="this.parentElement.remove()">
            <i class="bi bi-x"></i>
        </button>
    </div>
}

<div class="container rms-container">
    <div class="rms-section-title">
        <div style="color:var(--rms-silver); text-transform:uppercase; letter-spacing:3px; font-size:0.8rem; margin-bottom:0.5rem;">Our Menu</div>
        <h1>Crafted With Care</h1>
        <p>Explore today's selection &mdash; every dish available to order right now.</p>
    </div>

    <div class="menu-cart-action">
        <a asp-controller="Orders"
           asp-action="Create"
           class="menu-view-cart">

            <i class="bi bi-bag"></i>

            <span>View Cart</span>

            <i class="bi bi-arrow-right"></i>

        </a>
    </div>
    <!-- Category Filter -->

    <div class="menu-category-filter">

        <a asp-controller="Products"
           asp-action="Index"
           class="menu-filter-btn @(string.IsNullOrEmpty(Context.Request.Query["category"]) ? "active" : "")">
            All
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Burgers"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Burgers" ? "active" : "")">
            Burgers
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Pizza"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Pizza" ? "active" : "")">
            Pizza
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Pasta"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Pasta" ? "active" : "")">
            Pasta
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Sandwiches"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Sandwiches" ? "active" : "")">
            Sandwiches
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Sides"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Sides" ? "active" : "")">
            Sides
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Meals"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Meals" ? "active" : "")">
            Meals
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Drinks"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Drinks" ? "active" : "")">
            Drinks
        </a>

        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="Desserts"
           class="menu-filter-btn @(Context.Request.Query["category"] == "Desserts" ? "active" : "")">
            Desserts
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="rms-empty-state rms-surface">
            <div class="rms-empty-icon">&#127857;</div>
            <h5>Nothing on the menu right now</h5>
            <p class="text-muted mb-0">Please check back again soon.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="rms-menu-card">
                        <div class="rms-card-img-wrap">
                            @if (!string.IsNullOrEmpty(product.ImageFileName))
                            {
                                <img src="~/images/products/@product.ImageFileName" alt="@product.Name" />
                            }
                            else
                            {
                                <div class="rms-card-img-placeholder">&#127860;</div>
                            }
                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <span class="rms-category-badge">@product.Category</span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text">@product.Description</p>

                            <div class="rms-price">@product.Price.ToString("C")</div>

                            <div class="rms-card-actions">
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn rms-details-btn" aria-label="View details for @product.Name">
                                    <span>Details</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M5 12h13" stroke-linecap="round" />
                                        <path d="m14 7 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>

                                <form asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-silver">
                                        Add to Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
