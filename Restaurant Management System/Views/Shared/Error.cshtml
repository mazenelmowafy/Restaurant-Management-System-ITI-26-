@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container rms-container">
    <div class="rms-surface p-5 text-center" style="max-width:640px; margin:0 auto;">
        <div style="font-size:2.2rem; color:var(--rms-silver);">&#9888;</div>
        <h1 class="mt-3">Something Went Wrong</h1>
        <p style="color:var(--rms-text-muted)">
            We hit a snag while processing your request. Please try again.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="small" style="color:var(--rms-text-muted)">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn-silver mt-2">
            Back to Home
        </a>
    </div>
</div>
