@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using RestaurantManagementSystem.Data

@inject ApplicationDbContext _context

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    int cartCount = 0;

    if (User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Customer"))
    {
        var claim = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (int.TryParse(claim, out int customerId))
        {
            cartCount = _context.OrderItems
                .Where(i =>
                    i.Order.CustomerId == customerId &&
                    i.Order.Status == "Cart")
                .Sum(i => i.Quantity);
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Restaurant</title>


    <!-- Google Fonts -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet" />


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Customer CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =====================================================
         CUSTOMER NAVBAR
    ====================================================== -->

    <header class="customer-navbar">

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <!-- =========================
                 BRAND
            ========================== -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="restaurant-brand">

                    <span class="brand-mark">
                        <i class="bi bi-shop"></i>
                    </span>

                    <span class="brand-text">
                        <strong>Restaurant</strong>
                        <small>GOOD FOOD • GOOD MOOD</small>
                    </span>

                </a>


                <!-- =========================
                 MOBILE TOGGLE
            ========================== -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#customerNavbar"
                        aria-controls="customerNavbar"
                        aria-label="Toggle navigation">

                    <i class="bi bi-list"></i>

                </button>


                <!-- =========================
                 NAVIGATION
            ========================== -->

                <div class="collapse navbar-collapse"
                     id="customerNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a asp-controller="Home"
                               asp-action="About"
                               class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")">

                                About

                            </a>

                        </li>


                        <li class="nav-item">

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="nav-link @(currentController == "Products" ? "active" : "")">

                                Menu

                            </a>

                        </li>


                        <li class="nav-item">

                            <a asp-controller="Home"
                               asp-action="Contact"
                               class="nav-link @(currentController == "Home" && currentAction == "Contact" ? "active" : "")">

                                Contact

                            </a>

                        </li>

                    </ul>


                    <!-- =========================
                     RIGHT SIDE
                ========================== -->

                    <div class="customer-actions">


                        <!-- Search -->

                        <button type="button"
                                class="customer-action-btn"
                                aria-label="Search"
                                title="Search">

                            <i class="bi bi-search"></i>

                        </button>


                        <!-- Cart -->

                        <a asp-controller="Orders"
                           asp-action="Create"
                           class="navbar-cart-btn"
                           aria-label="Shopping Cart"
                           title="Shopping Cart">

                            <i class="bi bi-bag"></i>

                            @if (cartCount > 0)
                            {
                                <span class="cart-count">
                                    @cartCount
                                </span>
                            }

                        </a>


                        <!-- Divider -->

                        <span class="action-divider"></span>


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <!-- =========================
                             LOGGED IN ACCOUNT
                        ========================== -->

                            <div class="dropdown">

                                <button type="button"
                                        class="customer-account-btn"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="account-avatar">

                                        <i class="bi bi-person"></i>

                                    </span>


                                    <span class="account-details">

                                        <strong>
                                            @(User.Identity?.Name ?? "Account")
                                        </strong>

                                        <small>
                                            My Account
                                        </small>

                                    </span>


                                    <i class="bi bi-chevron-down account-chevron"></i>

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end customer-account-dropdown">


                                    <!-- Dropdown Header -->

                                    <li class="account-dropdown-header">

                                        <div class="dropdown-profile-icon">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <div>

                                            <strong>
                                                @(User.Identity?.Name ?? "My Account")
                                            </strong>

                                            <span>
                                                Manage your account
                                            </span>

                                        </div>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- My Profile -->

                                    <li>

                                        <a asp-controller="Account"
                                           asp-action="Profile"
                                           class="dropdown-item">

                                            <i class="bi bi-person"></i>

                                            <span>
                                                My Profile
                                            </span>

                                        </a>

                                    </li>


                                    <!-- My Orders -->

                                    <li>

                                        <a asp-controller="Orders"
                                           asp-action="Index"
                                           class="dropdown-item">

                                            <i class="bi bi-receipt"></i>

                                            <span>
                                                My Orders
                                            </span>

                                        </a>

                                    </li>


                                    <!-- My Cart -->

                                    <li>

                                        <a asp-controller="Orders"
                                           asp-action="Create"
                                           class="dropdown-item">

                                            <i class="bi bi-bag"></i>

                                            <span>
                                                My Cart
                                            </span>

                                            @if (cartCount > 0)
                                            {
                                                <span class="dropdown-cart-count">
                                                    @cartCount
                                                </span>
                                            }

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- Logout -->

                                    <li>

                                        <a asp-controller="Account"
                                           asp-action="Logout"
                                           class="dropdown-item customer-logout">

                                            <i class="bi bi-box-arrow-right"></i>

                                            <span>
                                                Logout
                                            </span>

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        }
                        else
                        {

                            <!-- =========================
                             NOT LOGGED IN
                        ========================== -->

                            <div class="guest-actions">

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="nav-login">

                                    Login

                                </a>

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="nav-register">

                                    Register

                                </a>

                            </div>

                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         PAGE CONTENT
    ====================================================== -->

    <main>

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="customer-footer">

        <div class="container">


            <div class="row g-5">


                <!-- Brand -->

                <div class="col-lg-4">


                    <a asp-controller="Home"
                       asp-action="Index"
                       class="footer-brand">


                        <span class="footer-brand-mark">

                            <i class="bi bi-shop"></i>

                        </span>


                        <span>

                            Restaurant

                        </span>

                    </a>


                    <p class="footer-description">

                        Great food, fresh ingredients,
                        and memorable moments.
                        Made with passion, served with care.

                    </p>


                    <!-- Social -->

                    <div class="footer-socials">

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                    </div>

                </div>


                <!-- Explore -->

                <div class="col-6 col-lg-2">

                    <h5>
                        Explore
                    </h5>


                    <ul>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="About">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Products"
                               asp-action="Index">
                                Our Menu
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- Customer -->

                <div class="col-6 col-lg-2">

                    <h5>
                        Account
                    </h5>


                    <ul>

                        <li>
                            <a asp-controller="Account"
                               asp-action="Profile">
                                My Profile
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Orders"
                               asp-action="Index">
                                My Orders
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Cart"
                               asp-action="Index">
                                My Cart
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Account"
                               asp-action="Settings">
                                Settings
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- Contact -->

                <div class="col-lg-4">

                    <h5>
                        Visit Us
                    </h5>


                    <div class="footer-contact">


                        <div>

                            <i class="bi bi-geo-alt"></i>

                            <span>
                                Damietta, Egypt
                            </span>

                        </div>


                        <div>

                            <i class="bi bi-telephone"></i>

                            <span>
                                +20 XXX XXX XXXX
                            </span>

                        </div>


                        <div>

                            <i class="bi bi-envelope"></i>

                            <span>
                                restaurant@example.com
                            </span>

                        </div>


                    </div>

                </div>

            </div>


            <!-- Bottom -->

            <div class="footer-bottom">

                <span>
                    © 2026 Restaurant Management System
                </span>


                <span>
                    Crafted for great food & good moments.
                </span>

            </div>

        </div>

    </footer>


    <!-- Bootstrap JS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>